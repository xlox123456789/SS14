{
  "name": "ss14-workspace",
  "private": true,
  "version": "0.5.3",
  "scripts": {
    "start": "node scripts/start-overlay.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:upstream": "node scripts/verify-upstream.cjs",
    "test:recognition": "node overlay/vendor/coffeebns/tools/scan-test.js --quick",
    "test:performance": "node tests/performance.cjs",
    "test:reliability": "node tests/reliability.cjs",
    "test:strategy-desktop": "node tests/strategy-desktop.cjs",
    "build:win": "electron-builder --projectDir overlay --win portable zip --x64 --publish never"
  },
  "devDependencies": {
    "electron-builder": "26.16.1"
  }
}
